name: refresh-picks

on:
  workflow_dispatch:
  push:
    paths:
      - "scripts/pipeline.py"
      - "scripts/build_site.py"
      - ".github/workflows/refresh.yml"
  schedule:
    # every 6 hours (inside the required 4-8h refresh band)
    - cron: "17 */6 * * *"

permissions:
  contents: write

concurrency:
  group: refresh-picks
  cancel-in-progress: false

jobs:
  refresh:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - name: Collect + model
        run: python3 scripts/pipeline.py

      - name: Build site
        run: |
          if [ -f scripts/build_site.py ]; then python3 scripts/build_site.py; fi

      - name: Verify data + links
        run: python3 scripts/verify.py

      - name: Show summary
        run: |
          echo "--- meta ---"; cat data/meta.json
          echo "--- git status ---"; git status --short | head -40

      - name: Commit failure log
        if: failure()
        run: |
          git config user.name "arena-pipeline"
          git config user.email "actions@users.noreply.github.com"
          git add -f data/error.json data/verification.json 2>/dev/null || true
          git commit -m "chore: pipeline error log [skip ci]" || echo "no error file"
          git pull --rebase origin "${GITHUB_REF_NAME}" || true
          git push origin "HEAD:${GITHUB_REF_NAME}" || true

      - name: Commit refresh
        run: |
          git config user.name "arena-pipeline"
          git config user.email "actions@users.noreply.github.com"
          git add data
          git add index.html 404.html sitemap.xml .nojekyll picks.html unresolved.html methodology.html sources.html flagged.html review.html 2>/dev/null || true
          git add picks unresolved methodology sources review 2>/dev/null || true
          git commit -m "chore(data): scheduled refresh $(date -u +%FT%TZ) [skip ci]" || echo "no changes"
          git pull --rebase origin "${GITHUB_REF_NAME}" || true
          git push origin "HEAD:${GITHUB_REF_NAME}"
